# Copy to .env and fill in.
X_BEARER_TOKEN=            # X developer app bearer token (pay-per-use credits loaded)
ANTHROPIC_API_KEY=         # used for pick extraction
EXTRACT_MODEL=claude-sonnet-5-5
NFL_WEEK1_TUESDAY=2026-09-08   # Tuesday before the season opener; weeks run Tue->Mon ET
MAX_TWEETS_PER_ACCOUNT=15      # newest posts kept per account per run (cost guard)
THEME_MIN_ACCOUNTS=2           # net accounts needed to label a team a passing/rushing threat
